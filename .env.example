# Optional API Keys for enhanced search and LLM reasoning
# If not provided, ShopBot will operate using built-in offline fallbacks.

# SerpAPI Key for live Google Shopping search in India (https://serpapi.com)
SERPAPI_KEY=

# Scrapingdog Key for fallback live search (https://scrapingdog.com)
SCRAPINGDOG_KEY=

# Groq API Key for fast LLM reasoning and response generation (https://groq.com)
GROQ_API_KEY=
